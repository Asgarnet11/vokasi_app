# Salin file ini jadi ".streamlit/secrets.toml" lalu isi dengan data asli kamu.
# JANGAN commit secrets.toml (file asli) ke Git / share ke publik.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/GANTI_DENGAN_ID_SPREADSHEET_KAMU/edit"

# Isi 6 baris di bawah dari file JSON service account yang kamu download di Google Cloud Console
type = "service_account"
project_id = "GANTI_PROJECT_ID"
private_key_id = "GANTI_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nGANTI_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "GANTI@GANTI.iam.gserviceaccount.com"
client_id = "GANTI_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "GANTI_CERT_URL"
